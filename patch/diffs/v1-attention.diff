     """HCA layer on FlashMLA sparse MLA (``fp8_ds_mla`` KV cache)."""
 
 
+class Ernie5_5HCAFlashInferSM120Attention(
+    Ernie5_5HCAAttentionMixin, DeepseekV4FlashInferSM120Attention
+):
+    """HCA layer on FlashInfer's SM120 sparse MLA (``fp8_ds_mla`` KV cache)."""
+
+    def forward_mqa(self, q, kv, positions, output):  # type: ignore[override]
+        super().forward_mqa(q, kv, positions, output)
+        # The SM120 kernels only write the rows of real tokens. CUDA-graph
+        # padding rows keep whatever the buffer held; left alone they grow to
+        # inf/NaN across layers and fault in the expert routing downstream.
+        attn_metadata = get_forward_context().attn_metadata
+        if isinstance(attn_metadata, dict):
+            swa_metadata = attn_metadata.get(self.swa_cache_layer.prefix)
+            valid = getattr(swa_metadata, "is_valid_token", None)
+            if valid is not None and valid.shape[0] >= output.shape[0]:
+                output.masked_fill_(~valid[: output.shape[0]].view(-1, 1, 1), 0)
+
+
+def _is_sm12x() -> bool:
+    capability = current_platform.get_device_capability()
+    return capability is not None and capability.major == 12
+
